{
  "name": "fin-bra",
  "version": "0.1.0",
  "description": "CLI de finanças pessoais feito para ser operado por uma IA no terminal: saída compacta, --json em todo comando e CLAUDE.md com as regras do domínio. Fatura de cartão item a item, parcelas, recorrentes e projeção de saldo. Postgres, sem build, uma dependência.",
  "keywords": [
    "financas",
    "finance",
    "cli",
    "postgres",
    "brasil",
    "orcamento",
    "budget",
    "fatura",
    "cartao-de-credito",
    "ai-agent",
    "claude-code",
    "agent-friendly",
    "llm"
  ],
  "license": "MIT",
  "author": "Patrick Schifter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickSchifter/fin-bra.git"
  },
  "bugs": {
    "url": "https://github.com/PatrickSchifter/fin-bra/issues"
  },
  "homepage": "https://github.com/PatrickSchifter/fin-bra#readme",
  "type": "module",
  "bin": {
    "fin": "./fin.mjs",
    "fin-painel": "./painel.mjs"
  },
  "files": [
    "fin.mjs",
    "painel.mjs",
    "parse-fatura.mjs",
    "schema.sql",
    "lib/"
  ],
  "scripts": {
    "test": "node --test",
    "painel": "node painel.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
