# String de conexão do Postgres.
#
# Local (docker run --name fin-pg -e POSTGRES_PASSWORD=senha -p 5432:5432 -d postgres):
DATABASE_URL=postgres://postgres:senha@localhost:5432/postgres
#
# Neon / Supabase / RDS: cole a connection string do painel do serviço.
# SSL é ligado sozinho para host remoto e desligado para localhost.
# DATABASE_URL=postgres://user:senha@ep-xxx.neon.tech/neondb

# Sobrescreve a decisão de SSL, se precisar: disable | no-verify | require
# DATABASE_SSL=

# Painel: porta e interface. Não exponha na rede — ele não tem senha.
# PORT=4173
# HOST=127.0.0.1

# `method` que você usa para movimento da conta corrente (não é cartão).
# CONTA_METHOD=conta
